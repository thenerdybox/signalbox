# Exclude everything by default, then allow project files back in.
/*

!/cmake
!/data
!/src
!/tests
!.clang-format
!.gersemirc
!.gitignore
!buildspec.json
!CMakeLists.txt
!CMakePresets.json
!LICENSE
!THIRD-PARTY-NOTICES.md
!README.md
!CHANGELOG.md
!DESIGN.md
!rate-limits.md

# CMake build trees and downloaded/built dependencies
/build_*
/.deps
/cmake/.CMakeBuildNumber

# Local secrets - tokens must never be committed (see TwitchClient/TokenStore)
tokens.bin
config.json
*.pdb

# Editor/OS noise
.vs/
.vscode/
*.user
.DS_Store
Thumbs.db

# Lock files
*.lock.json

# Installer script and its branding sources are build inputs, not output.
!/installer.iss
!/build-installer.ps1
# NOT tracked, deliberately: internal session notes. They stay on disk and
# keep working, they just do not go into a public repo. See the release
# procedure in README.md.
!/installer-assets
!/installer-version.iss

# Generated by CMake from buildspec.json at configure time (see CMakeLists.txt).
# Tracking it made every version bump leave the tree dirty, which in turn marked
# every build id "+" as if it came from unsaved edits.
installer-version.iss
